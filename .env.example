# ==============================================================================
# Environment Configuration Template
# DO NOT add real secret keys to this file. 
# Copy this file to '.env' and insert your real keys there:
#   cp .env.example .env
#
# '.env' is strictly ignored by .gitignore and will NEVER be committed to GitHub.
# ==============================================================================

# Google Cloud / Gemini API Configuration
GEMINI_API_KEY=""
GOOGLE_CLOUD_API_KEY=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION=""
# Optional: absolute path to a local service-account credential JSON file.
# Keep the JSON file outside this repository; never commit it.
GOOGLE_APPLICATION_CREDENTIALS=""

# OpenAI API Configuration (if using GPT backend)
OPENAI_API_KEY=""

